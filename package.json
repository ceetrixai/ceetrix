{
  "name": "ceetrix",
  "version": "1.1.1",
  "description": "Connect your coding agent to Ceetrix backlog management - Claude Code, Codex, pi, omp, OpenCode or DeepSeek Harness",
  "bin": {
    "ceetrix": "./bin/ceetrix.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mutate": "stryker run",
    "lint": "eslint src tests",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "open": "^10.0.0",
    "smol-toml": "^1.3.0",
    "which": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/typescript-checker": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@types/node": "^20.0.0",
    "@types/which": "^3.0.4",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "why-is-node-running": "^3.2.2"
  },
  "files": [
    "bin",
    "dist"
  ],
  "keywords": [
    "ceetrix",
    "mcp",
    "backlog",
    "claude-code",
    "codex",
    "pi",
    "omp",
    "oh-my-pi",
    "opencode",
    "deepseek-harness",
    "coding-agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ceetrixai/ceetrix.git"
  }
}
